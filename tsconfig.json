{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node", "vitest"]
	},
	"include": ["benchmarks/**/*.ts", "test/**/*.ts", "tools/**/*.ts", "vite.config.ts"],
	"exclude": ["test/parser/misc/**"]
}
